   "type": "range",
   "default": 84,
   "min": 0,
   "max": 360,
   "step": 0.5,
   "unit": "°",
   "ink": "f",
   "note": "OKLCH hue angle"
  },
  {
   "key": "holo",
   "label": "Holo spread",
   "group": "finish",
   "type": "range",
   "default": 0.6,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
    "finish": [
     "holo"
    ]
   },
   "note": "hue rotation per facet angle"
  },
