 "recipe": [
  "Die = the same shapes as FX-06; foil lands on the AA die × the stock: valleys below the starve height release no foil (pinholes), edge flash breaks the boundary at the film-split scale.",
  "Height = stock relief × (1 − crush) + foil grain (fine crumple) − a slight deboss; normals from it.",
  "Metal: a perspective viewer above the plate; the mirror vector per pixel samples the studio: a round soft box at the sheet light, a dim ceiling and a dark room. The reflection sweeps across the foil; tight Blinn glints are added; holo rotates the hue by the reflection direction.",
  "Off-foil paper keeps its own light."
 ],
 "limits": [
  {
   "param": "gloss",
   "range": "< 6",
   "what": "reads as metallic paint, not foil"
  },
  {
   "param": "foil grain",
   "range": "> .6 px",
   "what": "crinkled, like a chocolate wrapper"
  },
  {
   "param": "light elevation",
   "range": "> 75°",
   "what": "foil goes dark: metal reflects away from an overhead light"
  }
 ],
