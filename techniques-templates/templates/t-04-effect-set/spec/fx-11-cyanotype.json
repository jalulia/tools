{
 "id": "fx-11-cyanotype",
 "code": "FX-11",
 "name": "Cyanotype",
 "section": "changed",
 "kind": "process",
 "tool": "brush + sun",
 "mechanism": [
  "deposit",
  "expose"
 ],
 "role": "process · brush + sun",
 "set": "Set 01",
 "sub": "A sun print. Sensitizer is brushed on in ragged strokes that pool where the brush lands and run dry where it lifts; a fern, grass or a cut-card motif sits on top and the sun does the rest. Where light reached, Prussian blue; under the object, paper. Lifted parts throw soft, offset shadows away from the sheet light. Pressed parts stay sharp.",
 "entry": {
  "scripts": [
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/fx.js",
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/set.js"
  ],
  "globals": [
   "FX",
   "FXSET"
  ],
  "find": "FXSET.effects.find(e => e.id === 'fx-11-cyanotype')",
  "call": "fx.run(o, W, H, dpr, { S, clips })",
  "standalone": "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/lift/fx-11-cyanotype.html"
 },
 "signature": {
  "in": {
   "o": "params object — keys below; every length in CSS px",
   "W": "device px width",
   "H": "device px height",
   "dpr": "device px per CSS px (density is physical: marks per CSS px²)",
   "x": {
    "S": "params of every effect keyed by id; the stock this prints on is read from S[printsOn]",
    "clips": "Float32Array alpha per name (obj), from FXSET.clips('fx-11-cyanotype', W, H, dpr, o) on a thread with fonts",
    "umask": "optional: clips.umask — a typed or image mask (mShape type | image)"
   }
  },
  "out": {
   "lin": "Float32Array W·H·3, linear-light sRGB, lit (encode with FX.toRGBA(R,\"image\",W,H))",
   "alb": "Float32Array W·H·3, unlit albedo",
   "lf": "Float32Array W·H·3, diffuse light factor",
   "ink": "Float32Array W·H, this effect's own separation (plate), 0..1 (FX.toRGBA(R,\"ink\",…) = film positive)",
   "stock": "Float32Array W·H, height in CSS px (FX.toRGBA(R,\"stock\",…) = normalized height map)",
   "mask": "Float32Array W·H, coverage 0..1",
   "marks": "int: count of marks (pixel counts are per CSS px²)",
   "markUnit": "string"
  }
 },
 "light": {
  "global": "FX.LIGHT",
  "default": {
   "az": 225,
   "el": 34
  },
  "note": "az = direction the light comes FROM (screen degrees; 0 = right, 90 = below); el = elevation above the sheet"
 },
 "printsOn": "fx-03-paper-tooth",
 "deterministic": "yes: every random draw derives from the seed (position hashes or a seeded sequence); same inputs → same pixels in the same engine",
