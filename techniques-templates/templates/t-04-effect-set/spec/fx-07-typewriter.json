   "label": "Prints on",
   "group": "transfer",
   "type": "select",
   "default": "paper",
   "options": [
    "paper",
    "cloth",
    "smooth"
   ],
   "note": "paper = FX-03 live, cloth = FX-04 live, smooth = no substrate (film-splitting noise only). Tune the stock and this plate redraws."
  },
  {
   "key": "bite",
   "label": "Stock bite",
   "group": "transfer",
   "type": "range",
   "default": 0.55,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
    "stock": [
     "paper",
     "cloth"
    ]
   },
   "note": "how much the stock height (vs film-splitting noise) decides where ink lands"
  },
  {
   "key": "breakup",
   "label": "Break-up ↔ thin",
   "group": "transfer",
   "type": "range",
   "default": 0.85,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "limits": [
    {
     "lo": 0,
     "hi": 0.3,
     "why": "reads as a gradient"
    }
   ],
   "note": "1 = ink film breaks into marks on the peaks as pressure falls; 0 = the film stays whole and thins to tone"
  },
  {
   "key": "starve",
   "label": "Starve",
   "group": "transfer",
   "type": "range",
   "default": 0.03,
   "min": 0,
   "max": 0.3,
   "step": 0.002,
   "note": "the lowest share of the surface never takes ink. Pinholes in the solid, placed by the paper's valleys and pits"
  },
  {
   "key": "wick",
   "label": "Wick",
   "group": "transfer",
   "type": "range",
   "default": 0.12,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
