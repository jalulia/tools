     "cloth"
    ]
   },
   "note": "how much the stock height (vs film-splitting noise) decides where ink lands"
  },
  {
   "key": "breakup",
   "label": "Break-up ↔ thin",
   "group": "transfer",
   "type": "range",
   "default": 0.85,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "limits": [
