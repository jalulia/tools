 "recipe": [
  "Text in Courier Prime (a typewriter slab; bold below 15 px, as a light strike loses thin strokes), one strike per glyph on the main thread: pressure = ribbon life (exhausting along the page) × key variance; offset, rotation, an occasional dropped baseline; a half strike is a linear pressure ramp across the glyph, fading top or bottom.",
  "Ribbon: a plain weave at the ribbon count. Ink transfers through thread crossings, less through the gaps.",
  "Ink chain: pressure × ribbon vs stock-height percentile; ink squash pools film at the glyph edge.",
  "Impression: the strike dents the stock (blurred glyph × pressure); light from the combined height.",
  "Color: Beer–Lambert film."
 ],
 "limits": [
  {
   "param": "ribbon count",
   "range": "< 30 /100 px",
   "what": "weave reads as a screen pattern on the type"
  },
  {
   "param": "jitter",
   "range": "> 1.5 px",
   "what": "reads as broken font rendering"
  },
  {
   "param": "size",
   "range": "< 7 px",
   "what": "strokes thinner than the tooth lose the ribbon texture"
  }
 ],
