   "type": "range",
   "default": 0.25,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "ink fading along the text"
  },
  {
   "key": "ribbon",
   "label": "Ribbon texture",
   "group": "transfer",
   "type": "range",
   "default": 0.5,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "how much the ribbon weave shows in the glyphs"
  },
