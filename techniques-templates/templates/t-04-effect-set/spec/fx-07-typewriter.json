   "group": "transfer",
   "type": "range",
   "default": 0.35,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "film pooling at the glyph edge"
  },
  {
   "key": "impress",
   "label": "Press depth",
   "group": "relief",
   "type": "range",
   "default": 0.3,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "unit": "px",
   "note": "how deep each strike dents the stock"
  },
  {
   "key": "diffuse",
   "label": "Diffuse share",
   "group": "relief",
   "type": "range",
   "default": 0.7,
   "min": 0,
