   "label": "Size",
   "group": "motif",
   "type": "range",
   "default": 34,
   "min": 8,
   "max": 48,
   "step": 0.5,
   "unit": "px",
   "note": "type size in CSS px; bold below 15 px"
  },
  {
   "key": "lead",
   "label": "Leading",
   "group": "motif",
   "type": "range",
   "default": 1.5,
   "min": 1,
   "max": 2.4,
   "step": 0.01,
   "note": "line spacing as a multiple of the size"
  },
  {
   "key": "vari",
   "label": "Key variance",
   "group": "field",
   "type": "range",
   "default": 0.3,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "how unevenly keys strike"
  },
  {
   "key": "half",
   "label": "Half strikes",
   "group": "field",
   "type": "range",
   "default": 0.05,
   "min": 0,
   "max": 0.4,
   "step": 0.005,
   "note": "share of glyphs where only the top or bottom lands"
  },
  {
   "key": "jx",
   "label": "Jitter x",
   "group": "structure",
   "type": "range",
   "default": 0.35,
   "min": 0,
   "max": 2,
   "step": 0.01,
   "unit": "px",
   "note": "horizontal offset per strike"
  },
  {
   "key": "jy",
   "label": "Jitter y",
   "group": "structure",
   "type": "range",
   "default": 0.4,
   "min": 0,
   "max": 2,
   "step": 0.01,
   "unit": "px",
   "note": "vertical offset per strike"
  },
  {
