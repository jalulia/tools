{
 "id": "fx-12-laser",
 "code": "FX-12",
 "name": "Laser char",
 "section": "changed",
 "kind": "process",
 "tool": "CO2 beam",
 "mechanism": [
  "burn"
 ],
 "role": "process · CO2 beam",
 "set": "Set 01",
 "sub": "A CO₂ beam rasters a motif into card, one scan line at a time. Each line is a gaussian burn: past a threshold the paper scorches tan → brown → black, sinks, and the tooth is burned smooth; heat browns the fibers around it. Vector cuts go through: a charred kerf opening onto the dark bed below.",
 "entry": {
  "scripts": [
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/fx.js",
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/set.js"
  ],
  "globals": [
   "FX",
   "FXSET"
  ],
  "find": "FXSET.effects.find(e => e.id === 'fx-12-laser')",
  "call": "fx.run(o, W, H, dpr, { S, clips })",
  "standalone": "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/lift/fx-12-laser.html"
 },
 "signature": {
  "in": {
   "o": "params object — keys below; every length in CSS px",
   "W": "device px width",
   "H": "device px height",
   "dpr": "device px per CSS px (density is physical: marks per CSS px²)",
   "x": {
    "S": "params of every effect keyed by id; the stock this prints on is read from S[printsOn]",
    "clips": "Float32Array alpha per name (die), from FXSET.clips('fx-12-laser', W, H, dpr, o) on a thread with fonts",
    "umask": "optional: clips.umask — a typed or image mask (mShape type | image)"
   }
  },
  "out": {
   "lin": "Float32Array W·H·3, linear-light sRGB, lit (encode with FX.toRGBA(R,\"image\",W,H))",
   "alb": "Float32Array W·H·3, unlit albedo",
   "lf": "Float32Array W·H·3, diffuse light factor",
   "ink": "Float32Array W·H, this effect's own separation (plate), 0..1 (FX.toRGBA(R,\"ink\",…) = film positive)",
   "stock": "Float32Array W·H, height in CSS px (FX.toRGBA(R,\"stock\",…) = normalized height map)",
   "mask": "Float32Array W·H, coverage 0..1",
   "marks": "int: count of marks (pixel counts are per CSS px²)",
   "markUnit": "string"
  }
 },
 "light": {
  "global": "FX.LIGHT",
  "default": {
   "az": 225,
   "el": 34
  },
  "note": "az = direction the light comes FROM (screen degrees; 0 = right, 90 = below); el = elevation above the sheet"
