{
 "id": "fx-02-ink-edge",
 "code": "FX-02",
 "name": "Roller run-out",
 "section": "added",
 "kind": "mark",
 "tool": "roller",
 "mechanism": [
  "deposit"
 ],
 "role": "mark · roller",
 "set": "Set 01",
 "sub": "A solid that runs out. Roller pressure eases off across a warped edge; as it falls, only the peaks of the stock still touch the ink, so the run-out speckle is the paper's own tooth, with pinholes in its valleys and hairlines wicked along its fibers.",
 "entry": {
  "scripts": [
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/fx.js",
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/set.js"
  ],
  "globals": [
   "FX",
   "FXSET"
  ],
  "find": "FXSET.effects.find(e => e.id === 'fx-02-ink-edge')",
  "call": "fx.run(o, W, H, dpr, { S })",
  "standalone": "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/lift/fx-02-ink-edge.html"
 },
 "signature": {
  "in": {
   "o": "params object — keys below; every length in CSS px",
   "W": "device px width",
   "H": "device px height",
   "dpr": "device px per CSS px (density is physical: marks per CSS px²)",
   "x": {
    "S": "params of every effect keyed by id; the stock this prints on is read from S[printsOn]",
    "umask": "optional: clips.umask — a typed or image mask (mShape type | image)"
   }
  },
  "out": {
   "lin": "Float32Array W·H·3, linear-light sRGB, lit (encode with FX.toRGBA(R,\"image\",W,H))",
   "alb": "Float32Array W·H·3, unlit albedo",
   "lf": "Float32Array W·H·3, diffuse light factor",
   "ink": "Float32Array W·H, this effect's own separation (plate), 0..1 (FX.toRGBA(R,\"ink\",…) = film positive)",
   "stock": "Float32Array W·H, height in CSS px (FX.toRGBA(R,\"stock\",…) = normalized height map)",
   "mask": "Float32Array W·H, coverage 0..1",
   "marks": "int: count of marks (pixel counts are per CSS px²)",
   "markUnit": "string"
  }
 },
 "light": {
  "global": "FX.LIGHT",
  "default": {
   "az": 225,
   "el": 34
  },
  "note": "az = direction the light comes FROM (screen degrees; 0 = right, 90 = below); el = elevation above the sheet"
 },
 "printsOn": "fx-03-paper-tooth",
 "deterministic": "yes: every random draw derives from the seed (position hashes or a seeded sequence); same inputs → same pixels in the same engine",
 "params": [
  {
   "key": "streak",
   "label": "Streak",
   "group": "structure",
   "type": "range",
   "default": 1.25,
   "min": 1,
   "max": 10,
   "step": 0.1,
   "limits": [
    {
     "lo": 6,
     "hi": 10,
     "why": "scanlines on-axis"
    }
   ],
   "note": "film-split clumps stretched along the stroke: a dry roller, a dragged brush"
  },
  {
   "key": "pressure",
   "label": "Roller pressure",
   "group": "field",
   "type": "range",
   "default": 1,
   "min": 0.4,
   "max": 1,
   "step": 0.01,
   "note": "pressure in the solid; below 1 the body starts to open up"
  },
  {
   "key": "angle",
   "label": "Stroke angle",
   "group": "field",
   "type": "range",
   "default": 0,
   "min": 0,
   "max": 360,
   "step": 1,
   "unit": "°",
   "note": "direction the roller travels (it runs out along this vector)"
  },
  {
   "key": "edge",
   "label": "Edge position",
   "group": "field",
   "type": "range",
   "default": 0.58,
   "min": 0,
   "max": 1,
   "step": 0.005,
   "note": "where the run-out is centered across the plate"
  },
  {
   "key": "width",
   "label": "Transition",
   "group": "field",
   "type": "range",
   "default": 130,
   "min": 1,
   "max": 420,
   "step": 1,
   "unit": "px",
   "limits": [
    {
     "lo": 1,
     "hi": 4,
     "why": "hard vector edge"
    }
   ],
   "note": "width of the run-out band"
  },
  {
   "key": "ease",
   "label": "Dropoff curve",
   "group": "field",
   "type": "ease",
   "default": [
    "smooth",
    2
   ],
   "curves": [
    "linear",
    "smooth",
    "smoother",
    "in",
    "out",
    "inout",
    "expo",
    "sigmoid"
   ],
   "note": "pressure across the band: how fast the ink gives out"
  },
  {
   "key": "wAmp",
   "label": "Edge warp",
   "group": "field",
   "type": "range",
   "default": 18,
   "min": 0,
   "max": 90,
   "step": 0.5,
   "unit": "px",
   "note": "how far the edge line wanders"
  },
  {
   "key": "wScale",
   "label": "Warp scale",
   "group": "field",
   "type": "range",
   "default": 90,
   "min": 8,
   "max": 400,
   "step": 1,
   "unit": "px",
   "note": "wavelength of the wander"
  },
  {
   "key": "wOct",
   "label": "Warp octaves",
   "group": "field",
   "type": "range",
   "default": 3,
   "min": 1,
   "max": 5,
   "step": 1,
   "unit": "oct",
   "note": "detail in the wander"
  },
  {
   "key": "stock",
   "label": "Prints on",
   "group": "transfer",
   "type": "select",
   "default": "paper",
   "options": [
    "paper",
    "cloth",
    "smooth"
   ],
   "note": "paper = FX-03 live, cloth = FX-04 live, smooth = no substrate (film-splitting noise only). Tune the stock and this plate redraws."
  },
  {
   "key": "bite",
   "label": "Stock bite",
   "group": "transfer",
   "type": "range",
   "default": 0.5,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
    "stock": [
     "paper",
     "cloth"
    ]
   },
   "note": "how much the stock height (vs film-splitting noise) decides where ink lands"
  },
  {
   "key": "breakup",
   "label": "Break-up ↔ thin",
   "group": "transfer",
   "type": "range",
   "default": 0.94,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "limits": [
    {
     "lo": 0,
     "hi": 0.3,
     "why": "reads as a gradient"
    }
   ],
   "note": "1 = ink film breaks into marks on the peaks as pressure falls; 0 = the film stays whole and thins to tone"
  },
  {
   "key": "starve",
   "label": "Starve",
   "group": "transfer",
   "type": "range",
   "default": 0.005,
   "min": 0,
   "max": 0.3,
   "step": 0.002,
   "note": "the lowest share of the surface never takes ink. Pinholes in the solid, placed by the paper's valleys and pits"
  },
  {
   "key": "wick",
   "label": "Wick",
   "group": "transfer",
   "type": "range",
   "default": 0.35,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
    "stock": [
     "paper",
     "cloth"
    ]
   },
   "note": "ink carried along fibers into the run-out (hairline feathering)"
  },
  {
   "key": "mottle",
   "label": "Mottle",
   "group": "transfer",
   "type": "range",
   "default": 0.15,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "when": {
    "stock": [
     "paper"
    ]
   },
   "note": "paper formation (its low-frequency cloudiness) varying the film thickness"
  },
  {
   "key": "split",
   "label": "Film split",
   "group": "structure",
   "type": "range",
   "default": 1.1,
   "min": 0.5,
   "max": 10,
   "step": 0.1,
   "unit": "px",
   "note": "clump size of the film-splitting noise (the roller's own speckle)"
  },
  {
   "key": "iL",
   "label": "Ink · L",
   "group": "color",
   "type": "range",
   "default": 0.4,
   "min": 0,
   "max": 1,
   "step": 0.005,
   "ink": "i",
   "note": "OKLCH lightness (0 black … 1 white)"
  },
  {
   "key": "iC",
   "label": "Ink · C",
   "group": "color",
   "type": "range",
   "default": 0.155,
   "min": 0,
   "max": 0.37,
   "step": 0.002,
   "ink": "i",
