{
 "id": "fx-03-paper-tooth",
 "code": "FX-03",
 "name": "Paper tooth",
 "section": "stocks",
 "kind": "stock",
 "tool": "paper machine",
 "mechanism": [
  "form"
 ],
 "role": "stock · paper machine",
 "set": "Set 01",
 "sub": "White stock that is not a screen. A height field of tooth, formation, laid fibers and pits, lit by the one sheet light. On white the relief can only take light away, so the paper reads through its shadows. FX-01 and FX-02 print into this exact field.",
 "entry": {
  "scripts": [
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/fx.js",
   "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/set.js"
  ],
  "globals": [
   "FX",
   "FXSET"
  ],
  "find": "FXSET.effects.find(e => e.id === 'fx-03-paper-tooth')",
  "call": "fx.run(o, W, H, dpr, { S })",
  "standalone": "https://jalulia.github.io/tools/techniques-templates/templates/t-04-effect-set/lift/fx-03-paper-tooth.html"
 },
 "signature": {
  "in": {
   "o": "params object — keys below; every length in CSS px",
   "W": "device px width",
   "H": "device px height",
   "dpr": "device px per CSS px (density is physical: marks per CSS px²)",
   "x": {
    "S": "params of every effect keyed by id; the stock this prints on is read from S[printsOn]",
    "umask": "optional: clips.umask — a typed or image mask (mShape type | image)"
   }
  },
  "out": {
   "lin": "Float32Array W·H·3, linear-light sRGB, lit (encode with FX.toRGBA(R,\"image\",W,H))",
   "alb": "Float32Array W·H·3, unlit albedo",
   "lf": "Float32Array W·H·3, diffuse light factor",
   "ink": "Float32Array W·H, this effect's own separation (plate), 0..1 (FX.toRGBA(R,\"ink\",…) = film positive)",
   "stock": "Float32Array W·H, height in CSS px (FX.toRGBA(R,\"stock\",…) = normalized height map)",
   "mask": "Float32Array W·H, coverage 0..1",
   "marks": "int: count of marks (pixel counts are per CSS px²)",
   "markUnit": "string"
  }
 },
 "light": {
  "global": "FX.LIGHT",
  "default": {
   "az": 225,
   "el": 34
  },
  "note": "az = direction the light comes FROM (screen degrees; 0 = right, 90 = below); el = elevation above the sheet"
 },
 "printsOn": null,
 "deterministic": "yes: every random draw derives from the seed (position hashes or a seeded sequence); same inputs → same pixels in the same engine",
 "params": [
  {
   "key": "scale",
   "label": "Tooth scale",
   "group": "structure",
   "type": "range",
   "default": 1.1,
   "min": 0.5,
   "max": 24,
   "step": 0.05,
   "unit": "px",
   "limits": [
    {
     "lo": 0.5,
     "hi": 0.8,
     "why": "per-pixel noise"
    }
   ],
   "note": "feature size of the tooth (noise wavelength), not a tile zoom"
  },
  {
   "key": "oct",
   "label": "Octaves",
   "group": "structure",
   "type": "range",
   "default": 3,
   "min": 1,
   "max": 6,
   "step": 1,
   "unit": "oct",
   "note": "layers of finer detail"
  },
  {
   "key": "fibers",
   "label": "Fibers",
   "group": "structure",
   "type": "range",
   "default": 3,
   "min": 0,
   "max": 40,
   "step": 0.25,
   "unit": "/100×100 px",
   "limits": [
    {
     "lo": 30,
     "hi": 40,
     "why": "felt"
    }
   ],
   "note": "laid fibers per 100 × 100 CSS px"
  },
  {
   "key": "fLen",
   "label": "Fiber length",
   "group": "structure",
   "type": "range",
   "default": 14,
   "min": 2,
   "max": 80,
   "step": 0.5,
   "unit": "px",
   "note": "mean fiber length"
  },
  {
   "key": "fWidth",
   "label": "Fiber width",
   "group": "structure",
   "type": "range",
   "default": 0.25,
   "min": 0.2,
   "max": 3,
   "step": 0.02,
   "unit": "px",
   "note": "mean fiber width"
  },
  {
   "key": "pits",
   "label": "Pits",
   "group": "structure",
   "type": "range",
   "default": 1,
   "min": 0,
   "max": 40,
   "step": 0.25,
   "unit": "/100×100 px",
   "note": "depressions per 100 × 100 CSS px"
  },
  {
   "key": "pers",
   "label": "Persistence",
   "group": "structure",
   "type": "range",
   "default": 0.42,
   "min": 0.15,
   "max": 0.85,
   "step": 0.01,
   "note": "amplitude kept per octave: the spectral dropoff of the tooth"
  },
  {
   "key": "ease",
   "label": "Distribution",
   "group": "structure",
   "type": "ease",
   "default": [
    "in",
    2.4
   ],
   "curves": [
    "linear",
    "smooth",
    "smoother",
    "in",
    "out",
    "inout",
    "expo",
    "sigmoid"
   ],
   "note": "reshapes height: power in = mostly flat with sparse valleys (smooth stock); out = broad tooth (cold press)"
  },
  {
   "key": "aniso",
   "label": "Anisotropy",
   "group": "structure",
   "type": "range",
   "default": 1.6,
   "min": 1,
   "max": 6,
   "step": 0.05,
   "limits": [
    {
     "lo": 1,
     "hi": 1.3,
     "why": "reads as a stock emboss filter"
    }
   ],
   "note": "tooth stretched along the grain angle. Machine-made paper is never isotropic; 1 = the 1999 \"paper\" filter look"
  },
  {
   "key": "form",
   "label": "Formation",
   "group": "structure",
   "type": "range",
   "default": 0.3,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "low-frequency cloudiness of the sheet (fiber flocs); also mottles any ink printed on it"
  },
  {
   "key": "formScale",
   "label": "Formation scale",
   "group": "structure",
   "type": "range",
   "default": 60,
   "min": 10,
   "max": 200,
   "step": 1,
   "unit": "px",
   "note": "size of the flocs"
  },
  {
   "key": "fAngle",
   "label": "Grain angle",
   "group": "structure",
   "type": "range",
   "default": 6,
   "min": 0,
   "max": 180,
   "step": 1,
   "unit": "°",
   "note": "machine direction of the fibers and the tooth"
  },
  {
   "key": "fSpread",
   "label": "Grain spread",
   "group": "structure",
   "type": "range",
   "default": 0.4,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "0 = all fibers on the grain; 1 = any direction"
  },
  {
   "key": "depth",
   "label": "Relief",
   "group": "relief",
   "type": "range",
   "default": 0.06,
   "min": 0,
   "max": 1.6,
   "step": 0.005,
   "unit": "px",
   "limits": [
    {
     "lo": 0.6,
     "hi": 1.6,
     "why": "stucco: the 1999 emboss look"
    }
   ],
   "note": "height of the tooth in CSS px: how hard the light can rake it. The slider is weighted to the subtle end."
  },
  {
   "key": "diffuse",
   "label": "Diffuse share",
   "group": "relief",
   "type": "range",
   "default": 0.45,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "share of light from the sheet light vs flat ambient fill"
  },
  {
   "key": "fRaise",
   "label": "Fiber raise",
   "group": "relief",
   "type": "range",
   "default": 0.15,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "how far fibers stand proud of the sheet"
  },
  {
   "key": "pDepth",
   "label": "Pit depth",
   "group": "relief",
   "type": "range",
   "default": 0.35,
   "min": 0,
   "max": 1,
   "step": 0.01,
   "note": "how deep pits go"
  },
  {
   "key": "paperL",
   "label": "Paper L",
   "group": "color",
   "type": "range",
   "default": 0.968,
   "min": 0.85,
   "max": 1,
   "step": 0.001,
   "note": "OKLab lightness of the stock under the sheet light. Below 1 so lit walls, foil and sheen have headroom to brighten; 1 = the white of the page (highlights clip)"
  },
  {
   "key": "fDark",
