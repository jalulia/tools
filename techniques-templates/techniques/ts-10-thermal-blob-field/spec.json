    "px": [
      1200,
      800
    ],
    "grammar": "one blurred luminance field of large blobs, gradient-mapped through paper → blue → navy → plum → red → orange → yellow; mono grain; two hairline rules; a mono caption and a two-line label"
  },
  "units": "design units, 1000 = sheet width",
  "palette": {
    "paper": "#F0ECE3",
    "blue": "#5CA6DB",
    "navy": "#160F14",
    "plum": "#452333",
    "red": "#AF4E43",
    "orange": "#EE613F",
    "yellow": "#F2B815",
    "ink": "#1A1618"
  },
  "techniques": [
    {
      "id": "blob-field",
      "short": "BLOB",
      "name": "Blurred blob field",
      "layer": 1,
      "pass": 1,
      "atoms": [
        "blob",
        "fourier-radius",
        "gaussian-blur"
      ],
      "params": {
        "blobs": 4,
        "radius": "r(θ) = R·(1 + Σ a_k·cos(k·θ + φ_k)), k = 2..4, a ≤ 0.22",
        "shapes": [
          {
            "c": [
              340,
              -120
            ],
            "R": 250,
            "sx": 1.05,
            "sy": 0.7,
            "h": [
              [
                2,
                0.08,
                0.4
              ],
              [
                3,
                0.1,
                1.9
              ],
              [
                4,
                0.05,
                3.2
              ]
            ]
          },
          {
            "c": [
              210,
              610
            ],
            "R": 280,
            "sx": 1.15,
            "sy": 1,
            "h": [
              [
                2,
                0.16,
                3.14
              ],
              [
                3,
                0.14,
                4.71
              ],
              [
                4,
                0.05,
                4.4
              ],
              [
                5,
                0.04,
                1.2
              ]
            ]
          },
          {
            "c": [
              630,
              730
            ],
            "R": 200,
            "sx": 1.4,
            "sy": 0.62,
            "h": [
              [
                2,
                0.1,
                1.1
              ],
              [
                3,
                0.08,
                3
              ]
            ]
          },
          {
            "c": [
              1090,
              720
            ],
            "R": 150,
            "sx": 1,
            "sy": 1,
            "h": [
              [
                2,
                0.12,
                0.2
              ],
              [
                3,
                0.06,
                2.2
              ]
            ]
          }
        ],
        "R_scale": {
          "value": 1,
          "range": [
            0.4,
            1.8
          ],
          "note": "multiplies every blob radius"
        },
        "harmonic_scale": {
          "value": 1,
          "range": [
            0,
            2.5
          ],
          "note": "multiplies every a_k"
        },
        "blur_sigma_u": {
          "value": 46,
          "range": [
            6,
            140
          ],
          "unit": "u"
        },
        "res_div": {
          "value": 3,
          "range": [
            1,
            6
          ],
          "step": 1,
          "note": "field resolution = device px / res_div"
        },
        "fill": "radial white → 0.78 gray at the shape edge, union by lighten"
      },
      "limits": "Under σ ~15 u the edge profile is too steep for the ramp and the bands alias. Past σ ~110 u neighboring blobs fuse and the rim stop no longer closes. harmonic_scale above ~2 makes r(θ) cross zero and the outline self-intersects.",
      "implementation": "Four Fourier-radius blobs are filled with a radial white-to-gray gradient on a black canvas (union by lighten) at one-third resolution, blurred with σ = 46 u and read back as a 0..1 luminance field.",
      "module": "lib/blob-field.js"
    },
    {
      "id": "gradient-map",
      "short": "RAMP",
      "name": "Gradient map",
      "layer": 2,
      "pass": 2,
      "atoms": [
        "lut",
        "gradient-map"
      ],
      "params": {
        "lut": "256 entries",
        "stops_ref": "0.28 paper · 0.37 blue · 0.41 (53,80,126) · 0.44–0.48 navy · 0.53 plum · 0.64 red · 0.70 orange · 0.82 (245,140,30) · 1.0 yellow",
        "measured_edge_px": "paper→blue 12 · blue→navy 12 · navy 20 · plum→red 25 · red→orange 15 (at 1200 px)",
        "shift": {
          "value": 0,
          "range": [
            -0.2,
            0.2
          ],
          "note": "slides the field under the ramp"
        },
        "contrast": {
          "value": 1,
          "range": [
            0.5,
            2.5
          ],
          "note": "scales the field around 0.5 before the ramp"
        }
      },
      "limits": "The ramp is read at 256 levels; contrast above ~2 leaves fewer than 6 levels across the rim and it stair-steps. A shift past ±0.15 moves the paper stop into the blobs or the core out of range.",
      "implementation": "Every pixel of the field is replaced by LUT[field]; the ramp is the only place color enters, so all four colourways share one field.",
      "module": "lib/gradient-map.js"
    },
    {
      "id": "rim-stop",
      "short": "RIM",
      "name": "Dark rim stop",
      "layer": 2,
      "pass": 2,
      "atoms": [
        "lut-stop",
        "edge-band"
      ],
      "params": {
        "from": {
          "value": 0.44,
          "range": [
            0.415,
            0.5
          ],
          "note": "field value where the dark stop starts"
        },
        "to": {
          "value": 0.48,
          "range": [
            0.44,
            0.53
          ],
          "note": "field value where it ends"
        },
        "stops_at": [
          5,
          6
        ],
        "color": "#160F14",
        "band_px_ref": "≈ 20 at 1200 px",
        "halo": "blue 0.335–0.41 outside the stop"
      },
      "limits": "from must stay below to, and both inside 0.41–0.53 (the stops on either side). A band wider than ~0.07 reads as a dark fill, not an outline.",
      "implementation": "The darkest stop sits just under the mid-point of the blurred edge, where the profile is steepest, so it occupies few pixels and reads as a drawn outline; the blue halo is the ramp segment just outside it.",
      "module": "lib/rim-stop.js"
    },
    {
      "id": "paper-tooth",
      "short": "TOOTH",
      "name": "Paper tooth",
      "layer": 3,
      "pass": 3,
      "atoms": [
        "grain",
        "mottle"
      ],
      "params": {
        "grain_amp": {
          "value": 0.03,
          "range": [
            0,
            0.15
          ]
        },
        "pitch_px": 1,
        "mono": true,
        "seed": {
          "value": 1010,
          "range": [
            1,
            9999
          ],
          "step": 1
        },
        "mottle": {
          "formula": "perlin fbm, 3 octaves, overlay",
          "cell_u": {
            "value": 90,
            "range": [
              20,
              400
            ],
            "unit": "u"
          },
          "amp": {
            "value": 0.012,
            "range": [
              0,
              0.08
            ]
          },
          "octaves": 3,
          "gain": 0.55
        },
        "measured": "high-pass std 3.4/255 on paper, 5.5/255 in the core"
      },
      "limits": "Grain above ~0.08 reads as noise on the paper and breaks the rim. A mottle cell under ~30 u reads as a second grain.",
      "implementation": "Multiplicative mono grain per device pixel, then a low-frequency perlin mottle, both on the whole sheet including the blobs.",
      "module": "lib/paper-tooth.js"
    },
    {
      "id": "rule-ledger",
      "short": "RULE",
      "name": "Rules, caption and label",
      "layer": 4,
      "pass": 4,
      "atoms": [
        "hairline",
        "caption",
        "label"
      ],
      "params": {
        "rules": {
          "y_v": [
            0.475,
            0.925
          ],
          "inset_u": {
            "value": 12,
            "range": [
              0,
              80
            ],
            "unit": "u"
          },
          "weight_u": {
            "value": 1,
            "range": [
              0.5,
              5
            ],
            "unit": "u"
          },
          "color": "#1A1618"
        },
        "caption": {
          "font": "JetBrains Mono",
          "size_u": {
            "value": 14,
            "range": [
              8,
              26
            ],
            "unit": "u"
          },
          "align": "right, under rule 1",
          "x_u": 988
        },
        "label": {
          "font": "Inter 13 u / Inter 600 18 u",
          "lines": 2,
          "x_u": 12,
          "under": "rule 2"
        }
      },
      "limits": "Rules under 1 device px are drawn at 1 px. A caption past ~22 u collides with the second rule’s label on a narrow sheet.",
      "implementation": "Two 1 u ink rules across the sheet; the caption is set right-aligned 12 u under the first rule, the two-line studio label under the second.",
      "module": "lib/rule-ledger.js"
    }
  ],
  "pass_order": [
    "field · four blobs white on black at 1/3 res, blur σ 46 u",
    "upscale · field to device res",
    "map · LUT[field] per pixel (rim stop 0.44)",
    "tooth · mono grain 0.03, perlin mottle 0.012",
    "ledger · two rules, caption, two-line label"
  ],
  "notes": [
    "Measured on ref.png: paper (240,236,233) std 3.3; one edge at y = 300 runs (92,166,219) → (22,15,20) → (69,35,51) → (175,78,67) → (238,97,63) over 70 px; core (244,137,20); rules at y = 380 and 740 of 800, x 14 → 1185.",
    "Seed 1010. Motion: blob centres drift on perlin over a 12 s loop; field recomputed at half resolution per frame."
  ]
